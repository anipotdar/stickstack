{
  "manifest_version": 3,
  "name": "StickStack — Stickers for Substack Notes",
  "short_name": "StickStack",
  "version": "1.0.0",
  "description": "Bring your WhatsApp sticker collection to Substack. Import packs, then drop stickers into Notes and replies. 100% local, open source.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "StickStack",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "unlimitedStorage", "offscreen", "scripting", "activeTab"],
  "host_permissions": ["https://substack.com/*", "https://*.substack.com/*", "https://web.whatsapp.com/*"],
  "optional_host_permissions": ["https://*/*"],
  "content_scripts": [
    {
      "matches": ["https://substack.com/*", "https://*.substack.com/*"],
      "js": ["content/substack.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content/whatsapp.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-picker": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Open the sticker picker in the Substack box you're typing in"
    }
  }
}
